# User systemd unit of the @aphrody/ai-os relay (Linux: prd and workstations), without a browser.
# Source : frameworks/ai-os/src/relay, lu depuis un checkout git en lecture seule (SRC_ROOT, prd : /srv/src, clone
# partial sparse checkout kept up to date by src-checkout-update.timer, which restarts the relay if frameworks/ai-os changes).
# Installation : install -Dm644 aphrody-relay.service ~/.config/systemd/user/aphrody-relay.service
#                systemctl --user daemon-reload && systemctl --user enable --now aphrody-relay
#                loginctl enable-linger "$USER"   (start without an open session)
[Unit]
Description=Aphrody relay (Claude Code <-> Gemini, MCP, A2A, ACP, TCP/TLS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=RELAY_GEMINI=agy
Environment=RELAY_PORT=8790
Environment=RELAY_TCP_PORT=8791
Environment=SRC_ROOT=/srv/src
EnvironmentFile=-%h/.config/aphrody/relay.env
ExecStart=%h/.bun/bin/bun ${SRC_ROOT}/frameworks/ai-os/src/relay/cli.ts serve
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/.local/state/aphrody
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=default.target
