{
  "name": "open-aphrody-com",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "aphrody-open" }],
  "routes": [{ "pattern": "open.aphrody.com", "custom_domain": true }],
  "vars": {
    "PREFIX": "site",
    "SERVICE": "aphrody-open",
    "SPA": "1",
  },
}
