# GENERATED by infra/cluster/gen.ts: ssh to <member>-mesh = sshd through the mTLS mesh (TCP 7444).

Host fr1-mesh
    HostName @@hosts.fr1.public_ip@@
    HostKeyAlias fr1
    StrictHostKeyChecking accept-new # server already authenticated by the mesh certificate
    ConnectTimeout 10
    ServerAliveInterval 15
    ProxyCommand /usr/local/bin/aphrody-ssh-mesh fr1

Host fr2-mesh
    HostName @@hosts.fr2.public_ip@@
    HostKeyAlias fr2
    StrictHostKeyChecking accept-new # server already authenticated by the mesh certificate
    ConnectTimeout 10
    ServerAliveInterval 15
    ProxyCommand /usr/local/bin/aphrody-ssh-mesh fr2

Host prd-mesh
    HostName @@hosts.prd.public_ip@@
    HostKeyAlias prd
    StrictHostKeyChecking accept-new # server already authenticated by the mesh certificate
    ConnectTimeout 10
    ServerAliveInterval 15
    ProxyCommand /usr/local/bin/aphrody-ssh-mesh prd
