[Unit]
Description=ay index bench: symbol lookup and cache latency percentiles (fr2), appended to /var/lib/ay/index/bench.jsonl
After=network-online.target wg-quick@wg1.service

[Service]
Type=oneshot
User=ubuntu
StateDirectory=ay/index
Environment=HOME=/home/ubuntu
ExecStart=/bin/bash -c '/home/ubuntu/.local/bin/ay index bench --db /var/lib/ay/index/core.db --publish >> /var/lib/ay/index/bench.jsonl'
