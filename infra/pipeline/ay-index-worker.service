[Unit]
Description=ay index worker: heavy pipeline stages (Ghidra, LLVM) pulled from Valkey
After=network-online.target wg-quick@wg1.service
Wants=network-online.target

[Service]
User=ubuntu
Environment=SRC_ROOT=/srv/src
Environment=HOME=/home/ubuntu
ExecStart=/home/ubuntu/.local/bin/ay index worker --root /srv/src --role heavy
Restart=always
RestartSec=3
Nice=10
CPUWeight=50
MemoryMax=75%

[Install]
WantedBy=multi-user.target
