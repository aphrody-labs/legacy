# fr1: /home is btrfs on rotational sdb+sdc (95 % busy, 80 ms read await measured 2026-11-15) and the io scheduler is "none",
# where cgroup io.weight has no effect. bfq makes IOWeight of agents/bench/build slices effective on these disks.
ACTION=="add|change", KERNEL=="sd[bc]", ATTR{queue/rotational}=="1", ATTR{queue/scheduler}="bfq"
