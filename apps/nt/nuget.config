<?xml version="1.0" encoding="utf-8"?>
<!-- Deterministic .NET restore: nuget.org only, explicit mapping (NU1507 under central package management,
     https://aka.ms/nuget-package-source-mapping). The CI vcpkg binary cache has its own nuget.config (nugetconfig). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
