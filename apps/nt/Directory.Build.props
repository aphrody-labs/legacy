<Project>
  <!-- Cibles .NET de nt (SDK 11, global.json) :
       - applications: net11.0 (default below), NativeAOT (PublishAot);
       - libraries consumed by other .NET hosts: net10.0 (LTS) + net11.0. A library project writes
         <TargetFramework /> puis <TargetFrameworks>$(NtLibraryTargetFrameworks)</TargetFrameworks> : un TargetFramework
         inherited would disable multi-targeting. IsAotCompatible enables the AOT/trim analyzers on each target
         (Learn "Prepare .NET libraries for trimming", "Native AOT deployment"). -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <NtLibraryTargetFrameworks>net10.0;net11.0</NtLibraryTargetFrameworks>
    <IsAotCompatible Condition="'$(IsAotCompatible)' == ''">true</IsAotCompatible>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <ArtifactsPath>$(MSBuildThisFileDirectory)target/dotnet</ArtifactsPath>
    <Features>runtime-async=on</Features>
  </PropertyGroup>
</Project>
