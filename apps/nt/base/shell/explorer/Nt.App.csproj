<Project Sdk="Microsoft.NET.Sdk">
  <!-- Native nt shell: WinUI 3 (Windows App SDK 2.6.5, Fluent: NavigationView, Mica), code only (no XAML),
       NativeAOT (Learn "Windows App SDK 1.6 release notes": PublishAot supported, `partial` WinRT classes;
       WebView2 AOT-compatible since SDK 1.0.2839, here 1.0.3719.77 via Microsoft.WindowsAppSDK.WinUI 2.6.5).
       Two outputs of the same project, self-contained Windows App SDK in both cases (no runtime to install):
       - default: unpackaged (WindowsPackageType None, "custom Main" DISABLE_XAML_GENERATED_MAIN);
       - -p:NtPackage=msix: single-project MSIX (Learn "Package your app using single-project MSIX", EnableMsixTooling,
         GenerateAppxPackageOnBuild; same options as the microsoft/WinUI-Gallery CI). Signed if NT_CERT (pfx) and
         NT_CERT_PASSWORD are set; Windows App SDK dependencies included in the package (Learn "Windows App SDK
         deployment guide for self-contained apps"), the _RemoveWindowsAppSDKFrameworkReferences target of the
         Microsoft.WindowsAppSDK.Base 2.6.5 package removes the framework dependency. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Platforms>x64;ARM64</Platforms>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <!-- CsWinRT can generate unsafe code (Learn, 1.6 notes "Unsafe Code Error"). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OptimizationPreference>Size</OptimizationPreference>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <PropertyGroup Condition="'$(NtPackage)' != 'msix'">
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(NtPackage)' == 'msix'">
    <WindowsPackageType>MSIX</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <UapAppxPackageBuildMode>SideloadOnly</UapAppxPackageBuildMode>
    <AppxBundle>Never</AppxBundle>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
    <!-- NativeAOT: the IL .pdb and the native .pdb have the same name (APPX1101); the .pdb files are excluded from the package anyway
         (AppxPackageIncludePrivateSymbols=false, Microsoft.Windows.SDK.BuildTools.MSIX 1.7.251221100). -->
    <IncludeDebugSymbolsProjectOutputGroup>false</IncludeDebugSymbolsProjectOutputGroup>
    <!-- The package takes the NativeAOT output (group "publish items", GenerateAppxPackageOnBuild); the CopyLocal group
         would add the useless self-contained .NET runtime (coreclr.dll…): 101 MB -> 51 MB, measured on 2026-11-12. -->
    <IncludeCopyLocalFilesOutputGroup>false</IncludeCopyLocalFilesOutputGroup>
    <AppxPackageDir>$(ArtifactsPath)\msix\</AppxPackageDir>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxPackageSigningEnabled Condition="'$(NT_CERT)' != ''">true</AppxPackageSigningEnabled>
    <PackageCertificateKeyFile Condition="'$(NT_CERT)' != ''">$(NT_CERT)</PackageCertificateKeyFile>
    <PackageCertificatePassword Condition="'$(NT_CERT)' != ''">$(NT_CERT_PASSWORD)</PackageCertificatePassword>
  </PropertyGroup>
  <ItemGroup Condition="'$(NtPackage)' == 'msix'">
    <!-- MSIX logos from `ay brand build` (packages/design/brand/gen/icons/nt/msix/), linked into Assets\ of the package. -->
    <Content Include="$(MSBuildThisFileDirectory)..\..\..\..\..\assets\brand\gen\icons\nt\msix\*.png" Link="Assets\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>
</Project>
