# nt — single entry point. Architecture: docs/plan/architecture-microsoft.md.
# Windows (niubash) and Unix; recipes that read the real Windows are marked [windows].
set shell := ["sh", "-cu"]
set windows-shell := ["niu", "-cu"]

rid_os := if os() == "windows" { "win" } else if os() == "macos" { "osx" } else { "linux" }
rid_arch := if arch() == "aarch64" { "arm64" } else { "x64" }
rid := env("NT_RID", rid_os + "-" + rid_arch)
platform := if rid =~ "arm64$" { "ARM64" } else { "x64" }

default: lint web

# Pinned tools: DXC 1.9.2609, Agility SDK 1.620.2; Windows: niubash 1.5.0, CMake 4.5.0, Ninja 1.13.2 -> sdk/tools/
tools:
    bun sdk/tools/fetch-tools.ts

install:
    bun install --frozen-lockfile

lint: install
    bun fmt --check
    bun check

# Kernel GPU scene (WebGPU) -> target/web
web: install
    bun build modules/web/nt.html --outdir target/web --minify

# Serveur : noyau NT en direct (WebSocket /kernel), /api/icon, /api/index, /desktop.svg
serve: install
    bun sdk/tools/host/server.ts

# Full index of %SystemRoot% (FindFirstFileExW + SQLite FTS5 + PE headers) -> target/index/windows.sqlite
[windows]
index root="":
    bun sdk/tools/host/winindex.ts {{ root }} --pe

# Whole Windows desktop vectorized as SVG (UI Automation) -> target/desktop.svg
[windows]
desktop-svg:
    bun sdk/tools/host/desktop-svg.ts

# Windows development workstation: WinGet Configuration v3 (VS Build Tools 2026 + C++, .NET 11, bun, just, niubash, Rust…)
[windows]
setup:
    winget configure -f .config/configuration.winget

# Direct3D 12 capability probe: C++23 `import std` (CMake 4.5 + Ninja + MSVC), vcpkg (directx-headers, wil)
[windows]
probe: tools
    cd sdk/tools/gpuprobe && bun ../vsdev.ts cmake --workflow --preset windows

# Native WinUI 3 NativeAOT shell, unpackaged self-contained -> target/dotnet/publish/Nt.App/; data: `just serve`
[windows]
app:
    dotnet publish base/shell/explorer -c Release -r {{ rid }}

# .NET -> bun without node-api-dotnet (docs/bun/dotnet-native.md): Nt.Interop as IL (hostfxr) and NativeAOT, then
# bun:ffi bindings generated from the ECMA-335 metadata -> target/dotnet-ffi. Compiles: CI only.
interop:
    dotnet build sdk/dotnet/Nt.Interop -c Release
    dotnet publish sdk/dotnet/Nt.Interop -c Release -r {{ rid }}
    bun sdk/tools/dotnet-ffi/gen.ts target/dotnet/bin/Nt.Interop/release/Nt.Interop.dll --out target/dotnet-ffi --native target/dotnet/publish/Nt.Interop/release_{{ rid }}

# Interop tests (after `just interop`): NativeAOT then hosted CoreCLR, each in its own process
test-interop:
    bun test ./sdk/tools/dotnet-ffi/native.test.ts
    bun test ./sdk/tools/dotnet-ffi/hosted.test.ts

# bun -> .NET call cost (OS, JS, NativeAOT, CoreCLR) -> target/bench/dotnet-ffi-<rid>.json
bench-interop:
    NT_RID={{ rid }} bun sdk/tools/dotnet-ffi/bench.ts

# Feature graph of upstream bun (local source tree) -> docs/bun/feature-graph.{json,md}
bun-graph src:
    bun sdk/tools/bun-graph.ts {{ src }} --out docs/bun

# Recursive, proven index of the workstation's Microsoft stack (Win32/WDK/WinRT, Windows App SDK + WinUI 3, .NET 10/11, windows-rs,
# UCRT/CRT/STL) -> target/index/msindex.sqlite, docs/msindex/{lock.json,README.md}. src: root of the src monorepo.
[windows]
msindex src:
    bun sdk/tools/msindex/main.ts --src {{ src }}

# Reproducibility: inputs identical to the docs/msindex/lock.json lock and same graph fingerprint, otherwise failure
[windows]
msindex-verify src:
    bun sdk/tools/msindex/main.ts --src {{ src }} --verify

# Shell as single-project MSIX -> target/dotnet/msix/; signed if NT_CERT (pfx) and NT_CERT_PASSWORD are set
[windows]
msix:
    dotnet publish base/shell/explorer -c Release -r {{ rid }} -p:Platform={{ platform }} -p:NtPackage=msix

# WinUI 3 from Rust (windows-reactor, pinned windows-rs fork) -> target/cargo/release/reactor-winui-hello.exe
[windows]
winui-rs:
    cd sdk/rust && cargo -Zgit=shallow-deps build --release --locked
