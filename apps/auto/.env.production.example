# Copy to .env.production; never commit the secrets.
AUTO_DB_PASSWORD=replace-with-a-random-secret
AUTO_CLE_MAITRE=replace-with-64-hexadecimal-characters
AUTO_URL_APP=https://auto.example.com
AUTO_BIND=127.0.0.1
AUTO_PORT=3001
# Real SMTP relay, required at API startup in production.
AUTO_SMTP_HOTE=smtp.example.com
AUTO_SMTP_PORT=587
AUTO_SMTP_SECURITE=starttls
AUTO_SMTP_UTILISATEUR=auto@example.com
AUTO_SMTP_MOT_DE_PASSE=replace
# Production auto.aphrody.com (~/auto/prod.env on the VPS, see docs/DEPLOYMENT.md): Neon database, without the
# compose postgres service. Names only; the values come from `bun scripts/neon.ts env <file>`.
# DATABASE_URL=            # pooled URL (-pooler): API and worker
# DATABASE_URL_DIRECT=     # direct URL: migrations and pg_dump
# S3_ENDPOINT= S3_BUCKET= S3_ACCESS_KEY_ID= S3_SECRET_ACCESS_KEY= S3_REGION=   # S3 object storage for archiving
