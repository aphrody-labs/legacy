{
  "id": "autoEvenements01",
  "name": "auto: business events",
  "active": false,
  "settings": { "executionOrder": "v1" },
  "connections": {
    "Auto event": { "main": [[{ "node": "Verify signature", "type": "main", "index": 0 }]] },
    "Verify signature": {
      "main": [
        [
          { "node": "Invoice issued?", "type": "main", "index": 0 },
          { "node": "Reminder?", "type": "main", "index": 0 }
        ]
      ]
    },
    "Reminder?": { "main": [[{ "node": "Forward to reminders", "type": "main", "index": 0 }], []] },
    "Invoice issued?": { "main": [[{ "node": "Download the Factur-X", "type": "main", "index": 0 }], []] },
    "Download the Factur-X": { "main": [[{ "node": "Archive", "type": "main", "index": 0 }]] }
  },
  "nodes": [
    {
      "id": "8f0c2a0e-1b4e-4c55-9d3f-0a1b2c3d4e01",
      "name": "Auto event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "4b6f7a52-2d55-4f3e-8a77-auto0evenements",
      "parameters": { "httpMethod": "POST", "path": "auto-evenements", "responseMode": "onReceived", "options": {} }
    },
    {
      "id": "8f0c2a0e-1b4e-4c55-9d3f-0a1b2c3d4e02",
      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0],
      "parameters": {
        "jsCode": "// The body is the JSON.stringify of the event: re-serializing it gives back the signed bytes.\nconst crypto = require('crypto');\nconst secret = $env.N8N_WEBHOOK_SECRET;\nreturn $input.all().map((item) => {\n  const corps = JSON.stringify(item.json.body);\n  const attendu = 'sha256=' + crypto.createHmac('sha256', secret).update(corps).digest('hex');\n  const recu = String(item.json.headers['x-auto-signature'] ?? '');\n  if (recu.length !== attendu.length || !crypto.timingSafeEqual(Buffer.from(recu), Buffer.from(attendu))) {\n    throw new Error('Invalid signature');\n  }\n  return { json: item.json.body };\n});"
      }
    },
    {
      "id": "8f0c2a0e-1b4e-4c55-9d3f-0a1b2c3d4e03",
      "name": "Invoice issued?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [480, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict", "version": 2 },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.type }}",
              "rightValue": "document.emis",
              "operator": { "type": "string", "operation": "equals" }
            },
            {
              "id": "c2",
              "leftValue": "={{ $json.data.type }}",
              "rightValue": "facture",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "8f0c2a0e-1b4e-4c55-9d3f-0a1b2c3d4e04",
      "name": "Download the Factur-X",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, -80],
      "credentials": { "httpHeaderAuth": { "id": "autoApi000000001", "name": "API auto" } },
      "parameters": {
        "url": "={{ $env.AUTO_API_URL }}/v1/documents/{{ $json.data.id }}/pdf",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": { "response": { "response": { "responseFormat": "file" } } }
      }
    },
    {
      "id": "8f0c2a0e-1b4e-4c55-9d3f-0a1b2c3d4e05",
      "name": "Archive",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [960, -80],
      "parameters": {
        "operation": "write",
        "fileName": "=/archives/{{ $('Invoice issued?').item.json.tenantId }}_{{ $('Invoice issued?').item.json.data.numero }}.pdf",
        "options": {}
      }
    },
    {
      "id": "8f0c2a0e-1b4e-4c55-9d3f-0a1b2c3d4e06",
      "name": "Reminder?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [480, 200],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict", "version": 2 },
          "combinator": "and",
          "conditions": [
            {
              "id": "r1",
              "leftValue": "={{ $json.type }}",
              "rightValue": "relance.a_envoyer",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "8f0c2a0e-1b4e-4c55-9d3f-0a1b2c3d4e07",
      "name": "Forward to reminders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 200],
      "notes": "Original body and signature: auto-relances verifies the signature again.",
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5678/webhook/auto-relances",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-auto-signature", "value": "={{ $('Auto event').item.json.headers['x-auto-signature'] }}" },
            { "name": "x-auto-evenement", "value": "={{ $json.id }}" }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json) }}",
        "options": {}
      }
    }
  ]
}
