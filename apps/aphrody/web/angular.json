{
  "version": 1,
  "cli": {
    "analytics": false,
    "packageManager": "bun"
  },
  "projects": {
    "aphrody-m3": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "ay",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "outputPath": {
              "base": "../public/m3",
              "browser": ""
            },
            "outputHashing": "none",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "@aphrody/design/tokens.css",
              "src/styles.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "../../../node_modules"
              ]
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "350kB",
                  "maximumError": "500kB"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "aphrody-m3:build:production"
            },
            "development": {
              "buildTarget": "aphrody-m3:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
