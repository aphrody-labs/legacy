[Unit]
Description=ay index: incremental pass over the /srv/src checkout (stat skip, BLAKE3, stages, Valkey cache and queue)
After=network-online.target wg-quick@wg1.service

[Service]
Type=oneshot
User=ubuntu
StateDirectory=ay/index
Environment=SRC_ROOT=/srv/src
Environment=HOME=/home/ubuntu
ExecStart=/home/ubuntu/.local/bin/ay index /srv/src --db /var/lib/ay/index/core.db
ExecStartPost=/home/ubuntu/.local/bin/ay index sync --root /srv/src --db /var/lib/ay/index/core.db
Nice=10
