# Root Workspace Secret Guard (C:\aphrody)
.env
.env.*
!.env.example
!.env.template
.dev.vars
.dev.vars.*
*.pem
*.key
*.pfx
*.p12
.credentials.json
service-account*.json
node_modules/
target/
dist/
graphify-out/
.worktrees/

# Allowlist: the root repo is the manifest of the monorepo (units are submodules, upstreams are pinned in src.lock.json)
/*
!/.agents/
!/.gemini/
# dist-generated release workflow (dist-workspace.toml)
!/.github/
# Repo-wide cargo build settings only; credentials stay in $CARGO_HOME, never here.
!/.cargo/
/.cargo/*
!/.cargo/config.toml
!/.cargo/neoverse-512tvb.toml
!/.claude/
!/.claude-plugin/
/.claude/skills
/.claude/settings.local.json
!/docs/
!/src/
!/apps/
!/packages/
!/bench/
!/test/
!/build/
!/device/
!/prebuilts/
!/tools/
# Shell completions of Bun, embedded by src/runtime/cli/shell_completions.rs.
!/completions/
!/third_party/
/test/conformance/upstream/
/test/conformance/results/
!/rust-toolchain.toml
!/.gitignore
!/.gitattributes
!/.gitmodules
!/.graphifyignore
!/.env.example
!/DEPS
!/DEPS.rules
!/depot-artifacts.toml
!/OWNERS
!/AGENTS.md
!/CLAUDE.md
!/README.md
!/LICENSE.md
!/justfile
!/Cargo.toml
!/Cargo.lock
!/deny.toml
!/package.json
!/tsconfig.json
# Single monorepo version (docs/packaging/VERSIONING.md, ay release freeze).
!/bun.lock
!/bunfig.toml
!/pyproject.toml
!/uv.lock
!/go.work
!/src.lock.json
!/dist-workspace.toml


# third_party clones stay untracked (pinned in src.lock.json); only the ecosystem manifest is versioned.
!/third_party/
/third_party/*
!/third_party/ECOSYSTEM.toml
!/third_party/toolchain-*.toml
# Generated by `just trackers` (tools/trackers): live versions, code graph, README.chromium per checkout.
!/third_party/chromium-trackers.json
!/third_party/chromium-graph.json
!/third_party/chromium-graph.mmd
!/third_party/chromium-graph-components.mmd
!/third_party/metadata/
# Miroir texte des sources de design sous licence libre (docs/design/sources.toml, packages/design/src/design-mirror.ts).
!/third_party/design-mirror/
!/scripts/

packages/machine/matrix/bin/

# Large binary design sources (Figma exports, >100 MB): reproducible, not in git
assets/*.fig
assets/*.zip
apps/web/NUL
apps/.lst-*
# ay graph build outputs over 100 MB stay local (regenerate: ay graph build -o docs/nextjs/graph third_party/next.js)
/docs/*/graph/graph.json
/docs/*/graph/graph.html
/docs/*/graph/graph.graphml
/docs/*/graph/cypher.txt

# Upstream tracking snapshots written by `bun packages/upstream/src/upstream-scan.ts <fork>`: live data, regenerated on demand.
/docs/*/BLOG.md
/docs/*/COMMITS.md
/docs/*/PRS.md
/docs/*/RELEASES.md
/docs/*/data/prs.json

# aphrody-labs/open is its own repository (local clone)
/apps/open/

# build outputs
*.pyd
