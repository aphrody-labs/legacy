    fn_MAX_ENDPOINT_LATENCIES______________iter________________enumerate________________map___instance__latency_____________________let_svc___tower__service_fn_move___________________________let_start___Instant__now_________________________let_maxms___u64__from_latency_subsec_millis_____________________________saturating_add_latency_as_secs___saturating_mul_1_000________________________let_latency___Duration__from_millis_rand__random_range_0__maxms_________________________async_move___________________________time__sleep_until_start___latency__await__________________________let_latency___start_elapsed____________________________Ok_Rsp___latency__instance________________________________________________________________instance__ConcurrencyLimit__new_svc__ENDPOINT_CAPACITY_______________________________collect["MAX_ENDPOINT_LATENCIES
            .iter
            .enumerate
            .map|instance, latency| {
                let svc = tower::service_fnmove |_| {
                    let start = Instant::now;

                    let maxms = u64::fromlatency.subsec_millis
                        .saturating_addlatency.as_secs.saturating_mul1_000;
                    let latency = Duration::from_millisrand::random_range0..maxms;

                    async move {
                        time::sleep_untilstart + latency.await;
                        let latency = start.elapsed;
                        OkRsp { latency, instance }
                    }
                };

                instance, ConcurrencyLimit::newsvc, ENDPOINT_CAPACITY
            }
            .collect"]
