  "rules": [
    {
      "id": "web.seo.lighthouse-gate",
      "level": "MUST",
      "rule": "Each public page passes Lighthouse SEO category in CI without failure; all automated audits carry equal weight, structured data audit is manual and out of score.",
      "source": "https://developer.chrome.com/docs/lighthouse/seo/hreflang"
    },
    {
      "id": "web.seo.http-status",
      "level": "MUST",
      "rule": "Indexable pages respond with 2xx; error pages and 404s served with their actual 4xx/5xx codes and excluded from index.",
      "source": "https://developer.chrome.com/docs/lighthouse/seo/http-status-code"
    },
    {
      "id": "web.seo.title",
      "level": "MUST",
      "rule": "One unique, descriptive title per page and per SPA route.",
      "source": "https://web.dev/learn/accessibility/javascript"
    },
    {
      "id": "web.seo.meta-description",
      "level": "MUST",
      "rule": "A non-empty, unique, page-specific <meta name=\"description\"> in head; Lighthouse only checks presence, quality is our responsibility.",
      "source": "https://developer.chrome.com/docs/lighthouse/seo/meta-description"
    },
    {
      "id": "web.seo.canonical",
      "level": "MUST",
      "rule": "At most one canonical link, valid absolute URL, same domain, same language and region, not site root for a deep page.",
      "value": {
        "max_canonical_links": 1
      },
      "source": "https://developer.chrome.com/docs/lighthouse/seo/canonical"
    },
    {
      "id": "web.seo.indexable",
      "level": "MUST",
      "rule": "No noindex (meta robots or X-Robots-Tag header) on pages meant to be indexed; noindex only for voluntarily excluded content.",
      "source": "https://developer.chrome.com/docs/lighthouse/seo/is-crawlable"
    },
    {
      "id": "web.seo.robots-txt",
      "level": "MUST",
      "rule": "Valid robots.txt (declared user-agent, empty or //* patterns, known directives), served without 5xx, under 500 KiB; applies to entire host.",
      "value": {
        "max_kib": 500
      },
      "source": "https://developer.chrome.com/docs/lighthouse/seo/invalid-robots-txt"
    },
    {
      "id": "web.seo.sitemap",
      "level": "MUST",
      "rule": "Publish a sitemap and declare it in robots.txt with an absolute URL.",
      "source": "https://developer.chrome.com/docs/lighthouse/seo/invalid-robots-txt"
    },
    {
      "id": "web.seo.hreflang",
      "level": "MUST",
      "rule": "For each language variant, declare all versions via link rel=alternate hreflang (head, HTTP header, or sitemap) with valid language codes, absolute URLs, and x-default for language picker; Lighthouse checks neither regions nor sitemap.",
      "source": "https://developer.chrome.com/docs/lighthouse/seo/hreflang"
    },
    {
      "id": "web.seo.link-text",
      "level": "MUST",
      "rule": "Descriptive link text for the target; Lighthouse rejects generic labels (click here, click this, go, here, this, start, right here, more, learn more) and French equivalents are prohibited here.",
      "source": "https://developer.chrome.com/docs/lighthouse/seo/link-text"
    },
    {
      "id": "web.seo.crawlable-links",
      "level": "MUST",
      "rule": "House rule, no source page: Lighthouse crawlable-anchors audit page returns 404 on developer.chrome.com on 2026-11-13. Navigation uses real <a href> elements to resolvable URLs, never JavaScript alone on non-link elements."
    },
    {
      "id": "web.seo.structured-data",
      "level": "SHOULD",
      "rule": "Mark content type (article, product, FAQ…) with structured data per engine reference, on each relevant page, then validate; manual audit.",
      "source": "https://developer.chrome.com/docs/lighthouse/seo/structured-data"
    },
    {
      "id": "web.seo.no-plugins",
      "level": "MUST-NOT",
      "rule": "No plugin-dependent content (embed, object, applet with Java, Flash types…): it is not indexed.",
      "source": "https://developer.chrome.com/docs/lighthouse/seo/plugins"
    },
    {
      "id": "web.seo.tap-targets",
      "level": "SHOULD",
      "rule": "Touch targets at least 48 × 48 px with no more than 25% overlap within 48 px radius; accessibility normative minimum remains 24 px (web.a11y.target-size).",
      "value": {
        "min_px": 48,
        "max_overlap": 0.25
      },
      "source": "https://developer.chrome.com/docs/lighthouse/seo/tap-targets"
    },
    {
      "id": "web.seo.font-size-legibility",
      "level": "SHOULD",
      "rule": "Keep readable text at 12 px or larger on mobile for legibility; font-size audit was removed from Lighthouse 13, no longer an SEO signal.",
      "value": {
        "min_px": 12,
        "lighthouse": "removed in v13"
      },
      "source": "https://developer.chrome.com/blog/lighthouse-13-0"
    },
    {
      "id": "web.seo.beyond-lighthouse",
      "level": "SHOULD",
      "rule": "Lighthouse does not cover all SEO: also check guidelines for each target engine (Google Search, Bing, Yandex) and maintain Core Web Vitals from perf.core-web-vitals.",
      "source": "https://web.dev/articles/pass-lighthouse-seo-audit"
    }
  ]
}
