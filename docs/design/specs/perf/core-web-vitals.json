  "rules": [
    {
      "id": "web.cwv.p75",
      "level": "MUST",
      "rule": "Evaluate each metric at the 75th percentile of field-measured page loads, separately for mobile and desktop.",
      "value": {
        "percentile": 75,
        "segments": ["mobile", "desktop"]
      },
      "source": "https://web.dev/articles/vitals"
    },
    {
      "id": "web.cwv.pass-all-three",
      "level": "MUST",
      "rule": "A page passes only if LCP, INP, and CLS are all three in the 'good' zone at p75; a page fails for a metric once 25% of views cross the bad threshold.",
      "value": {
        "poor_share_trigger": 0.25
      },
      "source": "https://web.dev/articles/defining-core-web-vitals-thresholds"
    },
    {
      "id": "web.cwv.lcp-threshold",
      "level": "MUST",
      "rule": "LCP at p75 of 2500 ms or less; beyond 4000 ms the page fails.",
      "value": {
        "good_ms": 2500,
        "poor_above_ms": 4000
      },
      "source": "https://web.dev/articles/defining-core-web-vitals-thresholds"
    },
    {
      "id": "web.cwv.inp-threshold",
      "level": "MUST",
      "rule": "INP at p75 of 200 ms or less; between 200 and 500 ms needs improvement; beyond 500 ms is bad.",
      "value": {
        "good_ms": 200,
        "poor_above_ms": 500
      },
      "source": "https://web.dev/articles/inp"
    },
    {
      "id": "web.cwv.cls-threshold",
      "level": "MUST",
      "rule": "CLS at p75 of 0.1 or less; beyond 0.25 is bad.",
      "value": {
        "good": 0.1,
        "poor_above": 0.25
      },
      "source": "https://web.dev/articles/defining-core-web-vitals-thresholds"
    },
    {
      "id": "web.cwv.fcp-threshold",
      "level": "SHOULD",
      "rule": "FCP at p75 of 1800 ms or less; beyond 3000 ms is bad. Diagnostic metric, outside Core Web Vitals.",
      "value": {
        "good_ms": 1800,
        "poor_above_ms": 3000
      },
      "source": "https://web.dev/articles/fcp"
    },
    {
      "id": "web.cwv.ttfb-threshold",
      "level": "SHOULD",
      "rule": "TTFB at p75 of 800 ms or less; beyond 1800 ms is bad. Diagnostic: the actual goal is to keep FCP and LCP in the green.",
      "value": {
        "good_ms": 800,
        "poor_above_ms": 1800
      },
      "source": "https://web.dev/articles/ttfb"
    },
    {
      "id": "web.cwv.no-fid",
      "level": "MUST-NOT",
      "rule": "Stop targeting or reporting FID as a responsiveness metric: INP has replaced it among stable metrics.",
      "source": "https://web.dev/articles/vitals"
    },
    {
      "id": "web.cwv.inp-computation",
      "level": "SHOULD",
      "rule": "Calculate INP with the web-vitals library rather than manually; the algorithm excludes the worst interaction per 50 ms interval and the Event Timing API by default only reports events longer than 104 ms (adjustable minimum 16 ms).",
      "value": {
        "ignore_one_per_interactions": 50,
        "event_timing_default_threshold_ms": 104,
        "event_timing_min_threshold_ms": 16
      },
      "source": "https://web.dev/articles/inp"
    },
    {
      "id": "web.cwv.cls-session-window",
      "level": "MUST",
      "rule": "Interpret CLS as the worst burst of shifts: gaps under 1 s, window of at most 5 s; shifts occurring within 500 ms of user input are excluded.",
      "value": {
        "gap_ms": 1000,
        "window_max_ms": 5000,
        "recent_input_ms": 500
      },
      "source": "https://web.dev/articles/cls"
    },
    {
      "id": "web.cwv.lcp-breakdown",
      "level": "SHOULD",
      "rule": "Break down LCP into four sub-parts and target around 40% TTFB, less than 10% load delay, around 40% resource load time, less than 10% render delay; these are guidelines, not thresholds.",
      "value": {
        "ttfb_pct": 40,
        "resource_load_delay_pct_max": 10,
        "resource_load_duration_pct": 40,
        "element_render_delay_pct_max": 10
      },
      "source": "https://web.dev/articles/optimize-lcp"
    },
    {
      "id": "web.cwv.lcp-discoverable",
      "level": "MUST",
      "rule": "The LCP resource must be discoverable in initial HTML (img/srcset or preload) and start loading as early as possible, without depending on a script.",
      "source": "https://web.dev/articles/optimize-lcp"
    },
    {
      "id": "web.cwv.lcp-fetchpriority",
      "level": "SHOULD",
      "rule": "Mark the LCP image with fetchpriority=\"high\"; lower the priority of end-of-body scripts as needed.",
      "source": "https://web.dev/articles/fetch-priority"
    },
    {
      "id": "web.cwv.lcp-not-lazy",
      "level": "MUST-NOT",
      "rule": "Do not apply loading=\"lazy\" to the LCP image or above-the-fold images; native lazy-loading remains recommended for the rest.",
      "source": "https://web.dev/articles/lcp-lazy-loading"
    },
    {
      "id": "web.cwv.lcp-same-origin",
      "level": "SHOULD",
      "rule": "Serve the LCP resource from the document's origin; otherwise preconnect to the third-party origin (including image CDNs).",
      "source": "https://web.dev/articles/optimize-lcp"
    },
    {
      "id": "web.cwv.preload-order",
      "level": "SHOULD",
      "rule": "Order preloads: an HTTP header preload takes precedence; font preloads at end of head; image preloads (low or medium priority by default) positioned relative to async scripts.",
      "source": "https://web.dev/articles/fetch-priority"
    },
    {
      "id": "web.cwv.ttfb-remedies",
      "level": "SHOULD",
      "rule": "Reduce TTFB: appropriate hosting, CDN, cached content, no redirect chains, streamed HTML, service worker, 103 Early Hints for critical resources; instrument with Server-Timing.",
      "source": "https://web.dev/articles/optimize-ttfb"
    },
    {
      "id": "web.cwv.img-dimensions",
      "level": "MUST",
      "rule": "Give width and height (or aspect-ratio) to each image and video to reserve space before loading.",
      "source": "https://web.dev/articles/optimize-cls"
    },
    {
      "id": "web.cwv.reserve-late-content",
      "level": "MUST",
      "rule": "Reserve space for ads, embeds, and late content; load new content on explicit action (\"Load more\"); if content takes more than 500 ms, reserve space within that timeframe.",
      "value": {
        "reserve_within_ms": 500
      },
      "source": "https://web.dev/articles/optimize-cls"
    },
    {
      "id": "web.cwv.composited-animations",
      "level": "MUST-NOT",
      "rule": "Do not animate top, left, or properties that trigger layout; animate transform/translate, which does not count toward CLS.",
      "source": "https://web.dev/articles/optimize-cls"
    },
    {
      "id": "web.cwv.font-format",
      "level": "MUST",
      "rule": "Fonts in WOFF2 only, self-hosted and subset; never embed the font file as base64 in CSS.",
      "source": "https://web.dev/learn/performance/optimize-web-fonts"
    },
    {
      "id": "web.cwv.font-display",
      "level": "SHOULD",
      "rule": "Use font-display: optional (font used only if it arrives within 100 ms) to avoid shifting, or swap with an explicit fallback stack and size-adjust/ascent-override/descent-override/line-gap-override; preload critical fonts.",
      "value": {
        "optional_block_ms": 100
      },
      "source": "https://web.dev/articles/optimize-cls"
    },
    {
      "id": "web.cwv.long-task",
      "level": "MUST",
      "rule": "No main thread task should exceed 50 ms; beyond that, the excess is blocking time.",
      "value": {
        "long_task_ms": 50
      },
      "source": "https://web.dev/articles/optimize-long-tasks"
    },
    {
      "id": "web.cwv.yield",
      "level": "SHOULD",
      "rule": "Yield with await scheduler.yield() (prioritized continuation), with setTimeout(0) fallback detected by globalThis.scheduler?.yield; in loops, yield approximately every 50 ms rather than each iteration.",
      "value": {
        "yield_deadline_ms": 50,
        "support": {
          "chrome": 129,
          "firefox": 142,
          "safari": "no"
        }
      },
      "source": "https://web.dev/articles/optimize-long-tasks"
    },
    {
      "id": "web.cwv.no-isinputpending",
      "level": "MUST-NOT",
      "rule": "Do not use navigator.scheduling.isInputPending() to decide when to yield.",
      "source": "https://web.dev/articles/optimize-long-tasks"
    },
    {
      "id": "web.cwv.inp-phases",
      "level": "SHOULD",
      "rule": "Handle the three phases of an interaction: input delay (no concurrent long task), event callbacks (critical work first, rest deferred), presentation delay (minimal DOM, minimal rendering); each iframe has its own main thread.",
      "source": "https://web.dev/articles/optimize-inp"
    },
    {
      "id": "web.cwv.loaf",
      "level": "SHOULD",
      "rule": "In RUM, attribute slow interactions with long-animation-frame entries (Chrome 123+, feature detection required); blockingDuration sums tasks over 50 ms, script attribution covers scripts over 5 ms.",
      "value": {
        "chrome": 123,
        "blocking_task_ms": 50,
        "script_attribution_min_ms": 5
      },
      "source": "https://developer.chrome.com/docs/web-platform/long-animation-frames"
    },
    {
      "id": "web.cwv.content-visibility",
      "level": "SHOULD",
      "rule": "Apply content-visibility: auto with contain-intrinsic-size to long off-screen sections; do not call DOM APIs that force rendering of those sections; direct benefit to INP at startup.",
      "value": {
        "support": {
          "chrome": 85,
          "firefox": 125,
          "safari": 18
        }
      },
      "source": "https://web.dev/articles/content-visibility"
    },
    {
      "id": "web.cwv.bfcache-no-unload",
      "level": "MUST-NOT",
      "rule": "Never register an unload listener; use pagehide/visibilitychange.",
      "source": "https://web.dev/articles/bfcache"
    },
    {
      "id": "web.cwv.bfcache-no-store",
      "level": "SHOULD-NOT",
      "rule": "Avoid Cache-Control: no-store on the main document except truly sensitive pages; close open connections on pagehide, avoid window.opener, refresh stale data on persisted pageshow.",
      "source": "https://web.dev/articles/bfcache"
    },
    {
      "id": "web.cwv.bfcache-measure",
      "level": "SHOULD",
      "rule": "Measure bfcache restoration rate and diagnose failures with PerformanceNavigationTiming.notRestoredReasons (Chrome 123+), without relying on the text of reasons; count each restoration as a distinct visit (LCP = delta pageshow → next frame, INP reset to 0).",
      "value": {
        "notrestoredreasons_chrome": 123
      },
      "source": "https://developer.chrome.com/docs/web-platform/bfcache-notrestoredreasons"
    },
    {
      "id": "web.cwv.speculation-rules",
      "level": "SHOULD",
      "rule": "Preload or prerender likely navigations via document speculation rules with eagerness moderate (200 ms hover on desktop or pointerdown); reserve immediate for short lists; account for network, memory, and CPU cost.",
      "value": {
        "moderate_hover_ms": 200,
        "eager_hover_ms_desktop": 10
      },
      "source": "https://developer.chrome.com/docs/web-platform/prerender-pages"
    },
    {
      "id": "web.cwv.speculation-limits",
      "level": "MUST",
      "rule": "Respect Chrome limits: immediate 50 prefetch / 10 prerender; eager and moderate 2/2 on desktop, 6/2 on mobile; conservative 2/2 (FIFO). Chrome executes no speculation with Save-Data, power saver on low battery, memory constraint, disabled setting, or background tab.",
      "value": {
        "immediate": {
          "prefetch": 50,
          "prerender": 10
        },
        "eager_moderate_desktop": {
          "prefetch": 2,
          "prerender": 2
        },
        "eager_moderate_mobile": {
          "prefetch": 6,
          "prerender": 2
        },
        "conservative": {
          "prefetch": 2,
          "prerender": 2
        }
      },
      "source": "https://developer.chrome.com/docs/web-platform/prerender-pages"
    },
    {
      "id": "web.cwv.crux-plus-rum",
      "level": "SHOULD",
      "rule": "Complement CrUX (Chrome only, consenting users, no iOS) with own RUM measurement; do not expect identical numbers.",
      "source": "https://web.dev/articles/crux-and-rum-differences"
    },
    {
      "id": "web.cwv.rum-hygiene",
      "level": "MUST",
      "rule": "RUM measurement reports distributions (never averages), sends at the right time, creates no long task, and uses non-blocking APIs; version changes for correlation.",
      "source": "https://web.dev/articles/vitals-field-measurement-best-practices"
    },
    {
      "id": "web.cwv.lab-insights",
      "level": "SHOULD",
      "rule": "In lab, read Lighthouse 13 / DevTools insights (lcp-discovery-insight, lcp-phases-insight, interaction-to-next-paint-insight, cls-culprits-insight, document-latency-insight, render-blocking-insight, image-delivery-insight, font-display-insight); lab does not replace field p75.",
      "source": "https://developer.chrome.com/blog/lighthouse-13-0"
    }
  ]
}
