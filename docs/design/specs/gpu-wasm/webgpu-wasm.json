  "rules": [
    {
      "id": "web.webgpu.availability",
      "level": "MUST",
      "rule": "Consider WebGPU available by default in Chrome: since 113 on Windows (Direct3D 12), macOS and ChromeOS (Vulkan); Android 12+ (Qualcomm and ARM GPUs) since 121; Linux from 144 onwards (Intel Gen12+, Vulkan for WebGPU, OpenGL for the rest of Chromium) then 147-148 (recent NVIDIA under Wayland), in progressive rollout. Outside Chrome: Firefox 141 on Windows, Safari 26.",
      "value": {
        "chrome": {
          "windows_d3d12": 113,
          "macos": 113,
          "chromeos_vulkan": 113,
          "android_12_plus": 121,
          "linux_intel_gen12": 144,
          "linux_nvidia_wayland": "147-148"
        },
        "firefox_windows": 141,
        "safari": 26
      },
      "source": "https://developer.chrome.com/docs/web-platform/webgpu/news"
    },
    {
      "id": "web.webgpu.feature-detect",
      "level": "MUST",
      "rule": "Detect navigator.gpu then handle a null adapter (acceleration disabled, unsupported platform, blocklist, mismatched options, no GPU, repeated GPU process crashes) with a functional fallback (WebGL or DOM rendering).",
      "source": "https://developer.chrome.com/docs/web-platform/webgpu/troubleshooting-tips"
    },
    {
      "id": "web.webgpu.compat-mode",
      "level": "SHOULD",
      "rule": "To support legacy hardware, request the adapter with featureLevel: \"compatibility\" (Chrome 146, OpenGL ES 3.1) and stay within its limits, except explicit activation of core-features-and-limits.",
      "value": {
        "chrome": 146
      },
      "source": "https://developer.chrome.com/blog/new-in-webgpu-146"
    },
    {
      "id": "web.webgpu.limits-explicit",
      "level": "MUST",
      "rule": "Never assume hardware limits: requestDevice() returns lowest-common-denominator limits by default; explicitly request requiredLimits and requiredFeatures after reading adapter.limits and adapter.features, and plan a path without the feature.",
      "source": "https://developer.chrome.com/docs/web-platform/webgpu/from-webgl-to-webgpu"
    },
    {
      "id": "web.webgpu.windows-adapter",
      "level": "MUST",
      "rule": "On Windows, do not rely on powerPreference: Chrome uses the adapter already allocated to its other workloads (often the iGPU on laptops) and does not manage multiple adapters simultaneously.",
      "source": "https://developer.chrome.com/docs/web-platform/webgpu/troubleshooting-tips"
    },
    {
      "id": "web.webgpu.device-lost",
      "level": "MUST",
      "rule": "Plan for device loss (repeated GPU process crashes) and complete recreation of adapter, device and resources, according to device-loss best practices referenced by Chrome.",
      "source": "https://developer.chrome.com/docs/web-platform/webgpu/troubleshooting-tips"
    },
    {
      "id": "web.webgpu.async-errors",
      "level": "MUST",
      "rule": "Design for a fully asynchronous error model: a creation may appear to succeed and fail only later; never wait for synchronous GPU process response; name each object with label for actionable messages and tools.",
      "source": "https://developer.chrome.com/docs/web-platform/webgpu/from-webgl-to-webgpu"
    },
    {
      "id": "web.webgpu.pipelines",
      "level": "SHOULD",
      "rule": "Create immutable pipelines ahead of time and reuse them; do not literally transpose WebGL concepts (global state, synchronous waiting).",
      "source": "https://developer.chrome.com/docs/web-platform/webgpu/from-webgl-to-webgpu"
    },
    {
      "id": "web.webgpu.canvas",
      "level": "SHOULD",
      "rule": "Manage the canvas yourself (multisample then resolve for antialiasing); a single GPUDevice can serve multiple canvases, with no limit on number, unlike WebGL (16 canvases in Chrome and Safari).",
      "value": {
        "webgl_canvas_limit_chrome_safari": 16,
        "webgpu_canvas_limit": "aucune"
      },
      "source": "https://developer.chrome.com/docs/web-platform/webgpu/from-webgl-to-webgpu"
    },
    {
      "id": "web.webgpu.compute",
      "level": "MAY",
      "rule": "Offload heavy computations (massive layout, filters, ML) to compute shaders, absent in WebGL.",
      "source": "https://developer.chrome.com/docs/web-platform/webgpu/from-webgl-to-webgpu"
    },
    {
      "id": "web.webgpu.wgsl-extensions",
      "level": "SHOULD",
      "rule": "Use a recent WGSL language extension (linear_indexing 147-148, buffer_view and swizzle_assignment 153-154, fragment_depth 155-156) only after testing navigator.gpu.wgslLanguageFeatures, with requires directive at shader head and fallback shader.",
      "value": {
        "linear_indexing": "147-148",
        "buffer_view": "153-154",
        "swizzle_assignment": "153-154",
        "fragment_depth": "155-156"
      },
      "source": "https://developer.chrome.com/docs/web-platform/webgpu/news"
    },
    {
      "id": "web.webgpu.check-hw",
      "level": "MUST",
      "rule": "Before any slowness diagnosis, check in chrome://gpu \"WebGPU: Hardware accelerated\"; software mode invalidates measurements.",
      "source": "https://developer.chrome.com/docs/web-platform/webgpu/troubleshooting-tips"
    },
    {
      "id": "web.webgpu.native-dawn",
      "level": "MAY",
      "rule": "Share native and web rendering code via Dawn (C++, webgpu.h) compiled to WebAssembly with Emscripten.",
      "source": "https://developer.chrome.com/docs/web-platform/webgpu/build-app"
    },
    {
      "id": "web.webgpu.ui-a11y",
      "level": "MUST",
      "rule": "A GPU-rendered UI maintains a synchronized accessible DOM tree (roles, names, focus) and respects a11y and perf specs: canvas alone is not accessible. House rule.",
      "value": {
        "see": ["web.a11y", "web.core-web-vitals"]
      }
    },
    {
      "id": "web.wasm.streaming",
      "level": "MUST",
      "rule": "Load modules with WebAssembly.compileStreaming or instantiateStreaming on the fetch response, served with Content-Type: application/wasm.",
      "value": {
        "content_type": "application/wasm"
      },
      "source": "https://web.dev/articles/loading-wasm"
    },
    {
      "id": "web.wasm.compile-once",
      "level": "SHOULD",
      "rule": "Run heavy wasm in a Worker; compile the module once (compileStreaming) then instantiate it in the worker, without races between loading and messages.",
      "source": "https://web.dev/articles/webassembly-performance-patterns-for-web-apps"
    },
    {
      "id": "web.wasm.feature-cohorts",
      "level": "MUST",
      "rule": "Build one binary per feature cohort (SIMD, threads, exceptions…) plus a baseline binary, and choose at runtime with wasm-feature-detect.",
      "source": "https://web.dev/articles/webassembly-feature-detection"
    },
    {
      "id": "web.wasm.threads-coi",
      "level": "MUST",
      "rule": "Wasm threads require SharedArrayBuffer thus cross-origin isolation: headers Cross-Origin-Embedder-Policy: require-corp and Cross-Origin-Opener-Policy: same-origin; provide a variant without threads.",
      "value": {
        "COEP": "require-corp",
        "COOP": "same-origin"
      },
      "source": "https://web.dev/articles/webassembly-threads"
    },
    {
      "id": "web.wasm.same-origin-modules",
      "level": "MUST",
      "rule": "Pass a WebAssembly.Module via postMessage only between same-origin contexts (Chrome 95+); SharedArrayBuffer and WebAssembly.Memory also no longer pass to a page of the same site but different origin (Chrome 92+).",
      "value": {
        "module_chrome": 95,
        "sab_memory_chrome": 92
      },
      "source": "https://developer.chrome.com/blog/wasm-module-sharing-restricted-to-same-origin"
    },
    {
      "id": "web.wasm.memory-views",
      "level": "MUST-NOT",
      "rule": "Do not hold a memory view backed by wasm beyond a call (memory.grow invalidates the ArrayBuffer and all its views): copy on JS side; do not expose unmanaged objects to JS; no global mutable state.",
      "source": "https://web.dev/articles/webassembly-memory-debugging"
    },
    {
      "id": "web.wasm.sanitizers",
      "level": "SHOULD",
      "rule": "Run development builds under sanitizers; prefer a safe language or typed wrappers over raw pointers.",
      "source": "https://web.dev/articles/webassembly-memory-debugging"
    },
    {
      "id": "web.wasm.debug-dwarf",
      "level": "SHOULD",
      "rule": "Debug with separate DWARF 5 (-g -gsplit-dwarf -gdwarf-5, .dwo files) and strip the name section to reduce build and debugger loading.",
      "source": "https://developer.chrome.com/blog/faster-wasm-debugging"
    },
    {
      "id": "web.wasm.gc",
      "level": "MAY",
      "rule": "For garbage-collected languages (Kotlin, Dart), target WasmGC: Chrome 119, Firefox 120, Safari 18.2.",
      "value": {
        "chrome": 119,
        "firefox": 120,
        "safari": "18.2"
      },
      "source": "https://developer.chrome.com/blog/wasmgc"
    },
    {
      "id": "web.workers.offscreen-canvas",
      "level": "SHOULD",
      "rule": "Move canvas/WebGPU rendering into a Worker via transferred OffscreenCanvas (second argument of postMessage) and pace with the worker's requestAnimationFrame, not commit().",
      "value": {
        "support": {
          "chrome": 69,
          "firefox": 105,
          "safari": "16.4"
        }
      },
      "source": "https://web.dev/articles/offscreen-canvas"
    },
    {
      "id": "web.workers.module",
      "level": "SHOULD",
      "rule": "Use module workers (new Worker(url, { type: \"module\" })) and preload them with modulepreload.",
      "source": "https://web.dev/articles/module-workers"
    },
    {
      "id": "web.workers.main-thread-budget",
      "level": "MUST",
      "rule": "The main thread keeps only input and presentation: no task longer than 50 ms; the rest (wasm, decoding, GPU prep) in a worker or split with scheduler.yield.",
      "value": {
        "long_task_ms": 50
      },
      "source": "https://web.dev/articles/optimize-long-tasks"
    }
  ]
}
