  "rules": [
    {
      "id": "m3.motion.springs-first",
      "level": "SHOULD",
      "rule": "Animate components and interactions with the spring-physics system (M3 Expressive, May 2025); easing + duration remains a fallback, still used for page transitions, but no longer evolves.",
      "source": "https://m3.material.io/styles/motion/overview/how-it-works"
    },
    {
      "id": "m3.motion.scheme",
      "level": "SHOULD",
      "rule": "Choose a motion schema at product level: expressive (bounce, recommended default, key moments) or standard (no pronounced bounce, utility products); spring tokens do not carry the schema name.",
      "value": {
        "standard": {
          "fast-spatial": {
            "damping": 0.9,
            "stiffness": 1400
          },
          "fast-effects": {
            "damping": 1,
            "stiffness": 3800
          },
          "default-spatial": {
            "damping": 0.9,
            "stiffness": 700
          },
          "default-effects": {
            "damping": 1,
            "stiffness": 1600
          },
          "slow-spatial": {
            "damping": 0.9,
            "stiffness": 300
          },
          "slow-effects": {
            "damping": 1,
            "stiffness": 800
          }
        },
        "expressive": {
          "fast-spatial": {
            "damping": 0.6,
            "stiffness": 800
          },
          "fast-effects": {
            "damping": 1,
            "stiffness": 3800
          },
          "default-spatial": {
            "damping": 0.8,
            "stiffness": 380
          },
          "default-effects": {
            "damping": 1,
            "stiffness": 1600
          },
          "slow-spatial": {
            "damping": 0.8,
            "stiffness": 200
          },
          "slow-effects": {
            "damping": 1,
            "stiffness": 800
          }
        }
      },
      "source": "https://m3.material.io/styles/motion/overview/how-it-works"
    },
    {
      "id": "m3.motion.spatial-vs-effects",
      "level": "MUST",
      "rule": "Spatial springs for position, size, rotation, and corner radius (overshoot allowed); effects springs for color and opacity (no overshoot, damping 1).",
      "source": "https://m3.material.io/styles/motion/overview/how-it-works"
    },
    {
      "id": "m3.motion.speed",
      "level": "SHOULD",
      "rule": "Default speed by default; fast for small elements (button, switch); slow for fullscreen animations.",
      "source": "https://m3.material.io/styles/motion/overview/how-it-works"
    },
    {
      "id": "m3.motion.component-defaults",
      "level": "SHOULD",
      "rule": "Component internal motion relies on the two fast-spatial and fast-effects springs of the current schema.",
      "source": "https://m3.material.io/styles/motion/overview/how-it-works"
    },
    {
      "id": "m3.motion.web-curves",
      "level": "MAY",
      "rule": "On the web without a spring engine, approximate each spring using the published Bézier curve and conversion duration, only for uninterrupted animations without gestures.",
      "value": {
        "expressive": {
          "fast-spatial": ["cubic-bezier(0.42, 1.67, 0.21, 0.90)", "350ms"],
          "default-spatial": ["cubic-bezier(0.38, 1.21, 0.22, 1.00)", "500ms"],
          "slow-spatial": ["cubic-bezier(0.39, 1.29, 0.35, 0.98)", "650ms"],
          "fast-effects": ["cubic-bezier(0.31, 0.94, 0.34, 1.00)", "150ms"],
          "default-effects": ["cubic-bezier(0.34, 0.80, 0.34, 1.00)", "200ms"],
          "slow-effects": ["cubic-bezier(0.34, 0.88, 0.34, 1.00)", "300ms"]
        },
        "standard": {
          "fast-spatial": ["cubic-bezier(0.27, 1.06, 0.18, 1.00)", "350ms"],
          "default-spatial": ["cubic-bezier(0.27, 1.06, 0.18, 1.00)", "500ms"],
          "slow-spatial": ["cubic-bezier(0.27, 1.06, 0.18, 1.00)", "750ms"],
          "fast-effects": ["cubic-bezier(0.31, 0.94, 0.34, 1.00)", "150ms"],
          "default-effects": ["cubic-bezier(0.34, 0.80, 0.34, 1.00)", "200ms"],
          "slow-effects": ["cubic-bezier(0.34, 0.88, 0.34, 1.00)", "300ms"]
        }
      },
      "source": "https://m3.material.io/styles/motion/overview/specs"
    },
    {
      "id": "m3.motion.easing-pairs",
      "level": "SHOULD",
      "rule": "As easing + duration fallback: emphasized for main transitions, standard for small utility transitions; decelerate on entry, accelerate on exit, per reference pairs.",
      "value": [
        {
          "easing": "emphasized",
          "duration": "500ms",
          "use": "start and end on screen"
        },
        {
          "easing": "emphasized-decelerate",
          "duration": "400ms",
          "use": "entry on screen"
        },
        {
          "easing": "emphasized-accelerate",
          "duration": "200ms",
          "use": "exit from screen"
        },
        {
          "easing": "standard",
          "duration": "300ms",
          "use": "start and end on screen"
        },
        {
          "easing": "standard-decelerate",
          "duration": "250ms",
          "use": "entry on screen"
        },
        {
          "easing": "standard-accelerate",
          "duration": "200ms",
          "use": "exit from screen"
        }
      ],
      "source": "https://m3.material.io/styles/motion/easing-and-duration/applying-easing-and-duration"
    },
    {
      "id": "m3.motion.css-emphasized-fallback",
      "level": "MUST",
      "rule": "In CSS, emphasized (two-segment curve) does not exist in cubic-bezier: use standard as fallback, or a sampled linear() function.",
      "source": "https://m3.material.io/styles/motion/easing-and-duration/tokens-specs"
    },
    {
      "id": "m3.motion.transition-patterns",
      "level": "SHOULD",
      "rule": "Choose the transition pattern based on the relationship between views: container transform, forward/back, lateral, higher level, entry/exit; skeletons for loading.",
      "source": "https://m3.material.io/styles/motion/transitions/transition-patterns"
    },
    {
      "id": "m3.motion.reduced-motion",
      "level": "MUST",
      "rule": "Respect the animation reduction preference (prefers-reduced-motion, OS setting): replace movements and bounces with a short fade or immediate change.",
      "source": "https://m3.material.io/styles/motion/transitions/applying-transitions"
    }
  ],
