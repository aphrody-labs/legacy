  "rules": [
    {
      "id": "web.a11y.conformance-target",
      "level": "MUST",
      "rule": "Conformance target: WCAG 2.2 level AA (W3C Recommendation of 12 December 2024); AAA criteria cited here are SHOULD.",
      "value": {
        "standard": "WCAG 2.2",
        "level": "AA"
      },
      "source": "https://www.w3.org/TR/WCAG22/"
    },
    {
      "id": "web.a11y.semantic-html-first",
      "level": "MUST",
      "rule": "Use the native HTML element that already carries the role (button, a, nav, dialog…); ARIA only when no native element suits, and never redundant ARIA on a native element. WCAG 1.3.1, 4.1.2.",
      "value": {
        "wcag": ["1.3.1", "4.1.2"]
      },
      "source": "https://web.dev/learn/accessibility/aria-html"
    },
    {
      "id": "web.a11y.landmarks",
      "level": "MUST",
      "rule": "Structure the page into regions (header, nav, main, aside, footer; section only if named) and provide a skip link to main content. WCAG 1.3.1, 2.4.1.",
      "value": {
        "wcag": ["1.3.1", "2.4.1"]
      },
      "source": "https://web.dev/learn/accessibility/structure"
    },
    {
      "id": "web.a11y.headings",
      "level": "MUST",
      "rule": "Headings h1–h6 hierarchical without level skipping, never simulated by style alone; headings and labels descriptive. WCAG 1.3.1, 2.4.6.",
      "value": {
        "wcag": ["1.3.1", "2.4.6"]
      },
      "source": "https://web.dev/learn/accessibility/structure"
    },
    {
      "id": "web.a11y.layout-tables",
      "level": "MUST-NOT",
      "rule": "Do not use table for layout; if unavoidable, hide semantically with role=\"presentation\". Data tables with headers and caption.",
      "source": "https://web.dev/learn/accessibility/structure"
    },
    {
      "id": "web.a11y.page-title-lang",
      "level": "MUST",
      "rule": "Each view (including each SPA route) has a unique title and the page declares lang. WCAG 2.4.2, 3.1.1.",
      "value": {
        "wcag": ["2.4.2", "3.1.1"]
      },
      "source": "https://web.dev/learn/accessibility/javascript"
    },
    {
      "id": "web.a11y.accessible-name",
      "level": "MUST",
      "rule": "Every interactive element has an accessible name; the visible label is contained in the accessible name. WCAG 2.5.3, 4.1.2.",
      "value": {
        "wcag": ["2.5.3", "4.1.2"]
      },
      "source": "https://web.dev/learn/accessibility/aria-html"
    },
    {
      "id": "web.a11y.keyboard",
      "level": "MUST",
      "rule": "All functionality is keyboard-accessible; a custom control receives tabindex=\"0\" and responds to Enter and Space; no keyboard traps. WCAG 2.1.1, 2.1.2.",
      "value": {
        "wcag": ["2.1.1", "2.1.2"]
      },
      "source": "https://web.dev/learn/accessibility/javascript"
    },
    {
      "id": "web.a11y.no-positive-tabindex",
      "level": "MUST-NOT",
      "rule": "No positive tabindex; tabindex=\"-1\" only to remove from tab order an element that will receive focus by script.",
      "source": "https://web.dev/learn/accessibility/focus"
    },
    {
      "id": "web.a11y.no-hidden-focusable",
      "level": "MUST-NOT",
      "rule": "Do not hide from assistive technologies (aria-hidden) a focusable element or a focusable's parent.",
      "source": "https://web.dev/learn/accessibility/aria-html"
    },
    {
      "id": "web.a11y.focus-order",
      "level": "MUST",
      "rule": "Focus order follows visual order and DOM order. WCAG 2.4.3.",
      "value": {
        "wcag": ["2.4.3"]
      },
      "source": "https://web.dev/learn/accessibility/focus"
    },
    {
      "id": "web.a11y.focus-visible",
      "level": "MUST",
      "rule": "Focus indicator always visible (never outline: none without replacement), contrasted against background, and never fully hidden by fixed content. WCAG 2.4.7, 2.4.11; 2.4.13 (AAA) as SHOULD.",
      "value": {
        "wcag": ["2.4.7", "2.4.11"],
        "wcag_should": ["2.4.13"]
      },
      "source": "https://web.dev/learn/accessibility/focus"
    },
    {
      "id": "web.a11y.focus-management",
      "level": "MUST",
      "rule": "A modal confines focus until explicit closure then returns it to trigger; on route change, move focus to new content; dynamically added content receives focus or is announced.",
      "source": "https://web.dev/learn/accessibility/javascript"
    },
    {
      "id": "web.a11y.status-messages",
      "level": "MUST",
      "rule": "Status messages (success, errors, loading) are announced via a live region without moving focus. WCAG 4.1.3.",
      "value": {
        "wcag": ["4.1.3"]
      },
      "source": "https://web.dev/learn/accessibility/javascript"
    },
    {
      "id": "web.a11y.contrast-text",
      "level": "MUST",
      "rule": "Contrast of normal text, text images included, at least 4.5:1. WCAG 1.4.3.",
      "value": {
        "ratio": 4.5,
        "wcag": ["1.4.3"]
      },
      "source": "https://web.dev/learn/accessibility/color-contrast"
    },
    {
      "id": "web.a11y.contrast-large-icons",
      "level": "MUST",
      "rule": "Contrast at least 3:1 for large text (≥ 18 pt, or ≥ 14 pt bold), essential icons and interface components; logos and decoration exempt. WCAG 1.4.3, 1.4.11.",
      "value": {
        "ratio": 3,
        "large_text_pt": 18,
        "large_bold_text_pt": 14,
        "wcag": ["1.4.3", "1.4.11"]
      },
      "source": "https://web.dev/learn/accessibility/color-contrast"
    },
    {
      "id": "web.a11y.color-not-only",
      "level": "MUST",
      "rule": "Color is never the sole means of conveying information; a link in text differs other than by color or meets 3:1 against neighboring text. WCAG 1.4.1.",
      "value": {
        "link_vs_text_ratio": 3,
        "wcag": ["1.4.1"]
      },
      "source": "https://web.dev/learn/accessibility/test-manual"
    },
    {
      "id": "web.a11y.user-preferences",
      "level": "SHOULD",
      "rule": "Respect prefers-color-scheme and prefers-contrast, and let the user choose in the interface.",
      "source": "https://web.dev/learn/accessibility/color-contrast"
    },
    {
      "id": "web.a11y.text-resize-reflow",
      "level": "MUST",
      "rule": "Text remains readable when enlarged, page reflows without bidirectional scrolling, text spacing can be increased without loss. WCAG 1.4.4, 1.4.10, 1.4.12.",
      "value": {
        "wcag": ["1.4.4", "1.4.10", "1.4.12"]
      },
      "source": "https://web.dev/learn/accessibility/typography"
    },
    {
      "id": "web.a11y.target-size",
      "level": "MUST",
      "rule": "Pointer targets at least 24 × 24 px CSS (or equivalent spacing). WCAG 2.5.8. Stricter for mobile SEO: the Lighthouse tap-targets audit targets 48 × 48 px (see seo.web).",
      "value": {
        "min_css_px": 24,
        "wcag": ["2.5.8"]
      },
      "source": "https://www.w3.org/TR/WCAG22/"
    },
    {
      "id": "web.a11y.dragging",
      "level": "MUST",
      "rule": "Every drag action has a simple pointer alternative. WCAG 2.5.7.",
      "value": {
        "wcag": ["2.5.7"]
      },
      "source": "https://www.w3.org/TR/WCAG22/"
    },
    {
      "id": "web.a11y.form-labels",
      "level": "MUST",
      "rule": "Every field has a permanently visible label (placeholder does not count), instructions and formats are given before input, autocomplete is set. WCAG 1.3.5, 3.3.2.",
      "value": {
        "wcag": ["1.3.5", "3.3.2"]
      },
      "source": "https://web.dev/learn/accessibility/forms"
    },
    {
      "id": "web.a11y.form-errors",
      "level": "MUST",
      "rule": "The field in error is identified and the error described in text, with correction suggestion. WCAG 3.3.1, 3.3.3.",
      "value": {
        "wcag": ["3.3.1", "3.3.3"]
      },
      "source": "https://web.dev/learn/accessibility/forms"
    },
    {
      "id": "web.a11y.forms-wcag22",
      "level": "MUST",
      "rule": "Apply WCAG 2.2 criteria for forms: consistent help (3.2.6), no re-entry (3.3.7), accessible authentication without cognitive test (3.3.8), target size (2.5.8).",
      "value": {
        "wcag": ["3.2.6", "3.3.7", "3.3.8", "2.5.8"]
      },
      "source": "https://web.dev/learn/accessibility/forms"
    },
    {
      "id": "web.a11y.images-alt",
      "level": "MUST",
      "rule": "Informative or functional image: text alternative describing content or action; decorative image: empty alt or programmatically hidden; svg named by title/aria-label or role=\"img\"; complex image: linked long description. WCAG 1.1.1.",
      "value": {
        "wcag": ["1.1.1"]
      },
      "source": "https://web.dev/learn/accessibility/images"
    },
    {
      "id": "web.a11y.media",
      "level": "MUST",
      "rule": "Prerecorded video: captions and audio description; audio: transcript; any sound auto-played over 3 seconds can be paused or lowered. WCAG 1.2.2, 1.2.5, 1.4.2.",
      "value": {
        "autoplay_audio_max_s": 3,
        "wcag": ["1.2.2", "1.2.5", "1.4.2"]
      },
      "source": "https://web.dev/learn/accessibility/video-audio"
    },
    {
      "id": "web.a11y.no-flashing",
      "level": "MUST-NOT",
      "rule": "No content flashes more than three times per second above flash thresholds; test extreme motions with PEAT. WCAG 2.3.1.",
      "value": {
        "max_flashes_per_second": 3,
        "wcag": ["2.3.1"]
      },
      "source": "https://web.dev/learn/accessibility/motion"
    },
    {
      "id": "web.a11y.pause-motion",
      "level": "MUST",
      "rule": "Any motion auto-started, lasting over 5 seconds and presented alongside other content, can be paused, stopped, or hidden. WCAG 2.2.2.",
      "value": {
        "min_duration_s": 5,
        "wcag": ["2.2.2"]
      },
      "source": "https://web.dev/learn/accessibility/motion"
    },
    {
      "id": "web.a11y.reduced-motion",
      "level": "MUST",
      "rule": "Decorative animations with progressive enhancement: enabled only under prefers-reduced-motion: no-preference, reduced otherwise. WCAG 2.3.3 (AAA) applied as house rule.",
      "value": {
        "wcag_aaa": ["2.3.3"]
      },
      "source": "https://web.dev/learn/accessibility/motion"
    },
    {
      "id": "web.a11y.test-automated",
      "level": "MUST",
      "rule": "Run axe-core and Lighthouse Accessibility audit in CI; automation does not cover all criteria and produces false positives.",
      "source": "https://web.dev/learn/accessibility/test-automated"
    },
    {
      "id": "web.a11y.lighthouse-scoring",
      "level": "MUST",
      "rule": "Read the Lighthouse score as a weighted average of binary axe audits (weight 10 for ARIA errors and button names, 7 for contrast, bypass, etc.): a single faulty element fails the audit; target 100 and zero failures, without inferring WCAG compliance.",
      "value": {
        "weights_observed": [10, 7],
        "pass_fail": true
      },
      "source": "https://developer.chrome.com/docs/lighthouse/accessibility/scoring"
    },
    {
      "id": "web.a11y.test-manual",
      "level": "MUST",
      "rule": "Supplement with Lighthouse manual audits: no focus trap, logical tab order, focus directed to new content, landmark regions, custom controls named and roled, visual order = DOM order; then keyboard, visual, content, and screen reader tests.",
      "source": "https://developer.chrome.com/docs/lighthouse/accessibility/managed-focus"
    },
    {
      "id": "web.a11y.inclusive-design",
      "level": "SHOULD",
      "rule": "Integrate disability into personas, annotate mockups (focus order, landmarks, accessible names), and verify accessibility heuristics before implementation.",
      "source": "https://web.dev/learn/accessibility/design-ux"
    }
  ]
}
