{
  "spec": "geist.components",
  "domain": "components",
  "verified": "2026-11-13",
  "sources": [
    {
      "url": "https://vercel.com/geist/introduction",
      "license": "Vercel owner (https://vercel.com/legal/terms): read-only; prop names and values taken as facts, descriptions rewritten, no code or assets"
    },
    {
      "url": "https://vercel.com/geist/<composant>",
      "license": "Vercel owner: 75 pages read as text/markdown on 2026-11-13"
    }
  ],
  "rules": [
    {
      "id": "geist.comp.package",
      "level": "MAY",
      "rule": "Geist components are published for React under @vercel/geistcn; in src they are not a dependency (web target = Material Web), only a behavior reference.",
      "source": "https://vercel.com/geist/introduction"
    },
    {
      "id": "geist.comp.button-vs-link",
      "level": "MUST",
      "rule": "Button for an action that modifies state; link styled as button for navigation that changes URL; menu or split button when multiple related actions share a line.",
      "source": "https://vercel.com/geist/button"
    },
    {
      "id": "geist.comp.button-label",
      "level": "SHOULD",
      "rule": "Label names the result (verb + object: Deploy Project, Invite Member), never a bare verb or OK/Confirm; a destructive button and its toast answer each other (Delete Project then Project deleted).",
      "source": "https://vercel.com/geist/button"
    },
    {
      "id": "geist.comp.loading-in-place",
      "level": "MUST",
      "rule": "Loading state carried by the control itself: it remains focusable, keeps its label and announces occupancy (aria-busy) instead of being replaced by a spinner.",
      "source": "https://vercel.com/geist/button"
    },
    {
      "id": "geist.comp.disabled-explained",
      "level": "SHOULD",
      "rule": "Disable only if the action is impossible now (missing input, permissions) and explain why in a tooltip.",
      "source": "https://vercel.com/geist/button"
    },
    {
      "id": "geist.comp.icon-only-name",
      "level": "MUST",
      "rule": "Any icon-only control carries an accessible name describing the action and its target (Copy deployment URL), not the icon; a control with visible text does not receive an aria-label.",
      "source": "https://vercel.com/geist/button"
    },
    {
      "id": "geist.comp.hover-delay",
      "level": "SHOULD",
      "rule": "Tooltips and context cards open on hover and keyboard focus after a delay of about 150 ms to avoid flickering during sweep; Esc closes and returns focus to trigger.",
      "value": "150ms",
      "source": "https://vercel.com/geist/tooltip"
    },
    {
      "id": "geist.comp.overlay-focus",
      "level": "MUST",
      "rule": "Modal, drawer, sidebar, calendar and dropdowns trap focus while open and return it to trigger on close; title is linked by aria-labelledby.",
      "source": "https://vercel.com/geist/modal"
    },
    {
      "id": "geist.comp.cancel-literal",
      "level": "SHOULD",
      "rule": "The modal's cancel button is literally called Cancel to remain stable across destructive flows.",
      "source": "https://vercel.com/geist/modal"
    },
    {
      "id": "geist.comp.destructive-gate",
      "level": "MUST",
      "rule": "Irreversible deletion requires exact entry of a confirmation phrase; phrase and field are excluded from automatic translation (translate=no) so exact comparison remains possible.",
      "source": "https://vercel.com/geist/destructive-action-modal"
    },
    {
      "id": "geist.comp.live-regions",
      "level": "MUST",
      "rule": "Toasts, async errors, loading and result counts announce as aria-live polite; assertive is reserved for blocking errors.",
      "source": "https://vercel.com/geist/toast"
    },
    {
      "id": "geist.comp.toast-no-nav",
      "level": "MUST-NOT",
      "rule": "Do not place essential navigation in a toast: it disappears before being reached by keyboard.",
      "source": "https://vercel.com/geist/toast"
    },
    {
      "id": "geist.comp.group-fieldset",
      "level": "MUST",
      "rule": "Related checkboxes, radios and choiceboxes are grouped in fieldset + legend; a row selection checkbox without visible label receives an aria-label naming the row.",
      "source": "https://vercel.com/geist/checkbox"
    },
    {
      "id": "geist.comp.color-not-only",
      "level": "MUST",
      "rule": "Color is never the only signal (selection, threshold, status): text, check or redundant title required.",
      "source": "https://vercel.com/geist/status-dot"
    },
    {
      "id": "geist.comp.reduced-motion",
      "level": "MUST",
      "rule": "Spinners, loading dots, skeletons and autoplay videos respect prefers-reduced-motion; one animated indicator per row.",
      "source": "https://vercel.com/geist/loading-dots"
    },
    {
      "id": "geist.comp.progress-throttle",
      "level": "SHOULD",
      "rule": "Limit aria-valuenow updates of a progress bar to about once per second.",
      "value": "1s",
      "source": "https://vercel.com/geist/progress"
    },
    {
      "id": "geist.comp.keyboard-menus",
      "level": "MUST",
      "rule": "Menus: up/down arrows, Home/End, Enter/Space, search by first letter (visible label comes first), Esc closes; context menu openable by Shift+F10 or menu key, single submenu level for destructive actions.",
      "source": "https://vercel.com/geist/menu"
    },
    {
      "id": "geist.comp.tabs-keys",
      "level": "MUST",
      "rule": "Tabs: left/right arrows move focus, Enter/Space activate, focus ring visible on active tab, aria-label on list if no visible title.",
      "source": "https://vercel.com/geist/tabs"
    },
    {
      "id": "geist.comp.decorative-frames",
      "level": "MUST",
      "rule": "Presentation frames (browser, phone, book cover, grid guides) are aria-hidden and without focusable control; meaning is carried by internal image and its alt text.",
      "source": "https://vercel.com/geist/browser"
    },
    {
      "id": "geist.comp.sheet-measures",
      "level": "SHOULD",
      "rule": "Sidebar in inset variant by default: 12 px margin, 16 px corners, full height, max width 512 px; Close button visible because outside click does not close.",
      "value": { "margin": "12px", "radius": "16px", "maxWidth": "512px" },
      "source": "https://vercel.com/geist/sheet"
    },
    {
      "id": "geist.comp.avatar-pairing",
      "level": "SHOULD",
      "rule": "Avatar size matched to nearby text: 20-24 px with label-14, 32 px with label-16, 48-64 px in header or onboarding.",
      "value": {
        "label-14": "20-24px",
        "label-16": "32px",
        "header": "48-64px"
      },
      "source": "https://vercel.com/geist/avatar"
    },
    {
      "id": "geist.comp.url-state",
      "level": "SHOULD",
      "rule": "List filters live in the URL (sharing, reload, back/forward).",
      "source": "https://vercel.com/geist/filter-params"
    },
    {
      "id": "geist.comp.web-guidelines",
      "level": "MUST",
      "rule": "Cross-cutting UI rules (focus, targets, forms, content, perceived performance) are not duplicated here: apply skill vercel-agent-skills:web-design-guidelines (fork aphrody-labs/agent-skills, .agents/skills/web-design-guidelines).",
      "source": "https://vercel.com/design/guidelines"
    }
  ],
