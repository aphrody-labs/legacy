{
  "name": "@aphrody/monorepo",
  "version": "0.4.0",
  "private": true,
  "description": "Aphrody Monorepo Root - LLVM Pure C/ASM/WebAssembly 3.0 Core (src/aysys) + Bun v1.4.5 + Linux/systemd/Wayland/NT/Wine/ReactOS Isolation",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-labs/aphrody.git"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/aphrody/web",
      "apps/nt",
      "apps/nt/modules/web",
      "infra/cloudflare/workers/*"
    ],
    "catalog": {
      "@angular/build": "22.2.7",
      "@angular/cdk": "22.2.7",
      "@angular/cli": "22.2.7",
      "@angular/common": "22.2.6",
      "@angular/compiler": "22.2.6",
      "@angular/compiler-cli": "22.2.6",
      "@angular/core": "22.2.6",
      "@angular/forms": "22.2.6",
      "@angular/material": "22.2.7",
      "@angular/platform-browser": "22.2.6",
      "@cloudflare/vite-plugin": "2.0.0-beta.v.16",
      "@cloudflare/workers-types": "5.20261114.1",
      "@material/material-color-utilities": "0.4.0",
      "@types/bun": "1.4.4",
      "@webgpu/types": "0.1.74",
      "gltf-validator": "2.0.0-dev.3.10",
      "material-symbols": "0.49.0",
      "rxjs": "7.8.2",
      "sass": "1.108.2",
      "svgo": "4.1.0",
      "tslib": "2.9.1",
      "typescript": "6.0.3",
      "tree-sitter-c": "0.24.1",
      "tree-sitter-cpp": "0.23.4",
      "vite": "8.3.8",
      "wawoff2": "2.0.1",
      "web-tree-sitter": "0.27.2"
    }
  },
  "scripts": {
    "fmt": "bun fmt",
    "fmt:check": "bun fmt --check",
    "arch": "ay arch check --strict",
    "doctor": "ay arch check --strict && ay doctor && ay doctor --deps && env-kit doctor && src-deploy doctor",
    "test:packages": "bun test packages/env-kit packages/wck",
    "deploy": "src-deploy up --all --dry-run",
    "deploy:live": "src-deploy up --all",
    "deps": "ay doctor --deps"
  },
  "packageManager": "bun@canary",
  "engines": {
    "bun": ">=1.4.5"
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  },
  "overrides": {
    "tree-sitter-c": "0.24.1"
  }
}
