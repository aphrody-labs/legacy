{
  "name": "@aphrody/google",
  "version": "1.4.7",
  "description": "Aphrody Google: Cloud, Gemini, Drive, Docs, REST services (src/rest), gcloud principals and billing (src/gcp), document translation (src/doc-ai), Drive client (src/drive-client).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-labs/bun-distribution.git",
    "directory": "packages/google"
  },
  "bin": {
    "bun-google": "./src/rest/cli.ts",
    "bun-google-index-public": "./src/rest/public-index-cli.ts",
    "gcp": "./src/gcp/cli.ts"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime.ts",
    "./api": "./src/api.ts",
    "./rest": "./src/rest/index.ts",
    "./rest/services": "./src/rest/services.ts",
    "./rest/edge-proxy": "./src/rest/edge-proxy.ts",
    "./rest/cli": "./src/rest/cli.ts",
    "./rest/search": "./src/rest/search.ts",
    "./rest/public-index": "./src/rest/public-index.ts",
    "./rest/public-index-cli": "./src/rest/public-index-cli.ts",
    "./rest/password-store": "./src/rest/password-store.ts",
    "./drive-sync": "./src/drive-sync.ts",
    "./drive-model-sync": "./src/drive-model-sync.ts",
    "./gcp": "./src/gcp/index.ts",
    "./gcp/cli": "./src/gcp/cli.ts",
    "./doc-ai": "./src/doc-ai/index.ts",
    "./drive-client": "./src/drive-client/index.ts",
    "./drive-client/bun": "./src/drive-client/bun.ts",
    "./drive-client/hooks": "./src/drive-client/hooks/index.ts",
    "./drive-client/generated/types": "./src/drive-client/generated/types.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --format esm",
    "config": "bun src/rest/cli.ts config",
    "authstatus": "bun src/rest/cli.ts authstatus",
    "models": "bun src/rest/cli.ts models",
    "generate": "bun src/rest/cli.ts generate",
    "stream": "bun src/rest/cli.ts stream",
    "google:status": "bun ./src/cli.ts drive status",
    "google:sync": "bun ./src/cli.ts drive sync",
    "test": "bun test ./test",
    "verify": "bun run test && bun run build"
  },
  "dependencies": {
    "@ai-sdk/google-vertex": "5.0.101",
    "@aphrody/bun-google": "1.4.7",
    "@googleapis/docs": "14.1.0",
    "@googleapis/drive": "26.0.2",
    "ai": "7.0.127",
    "google-auth-library": "11.1.0",
    "@aphrody/assets": "1.4.7",
    "@aphrody/env-kit": "workspace:*",
    "@aphrody/vault": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "type-fest": "^4.30.0",
    "valibot": "^1.5.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0"
  }
}
