# Cross-platform Zsh configuration (Linux/macOS; cached 2026 CLI hooks for sub-25ms startup)
[[ -f "$HOME/.config/shell/env.sh" ]] && source "$HOME/.config/shell/env.sh"
[[ -o interactive ]] || return 0

HISTFILE="${XDG_STATE_HOME:-$HOME/.local/state}/zsh/history"
mkdir -p "${HISTFILE:h}" 2>/dev/null
HISTSIZE=100000
SAVEHIST=100000
setopt SHARE_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS AUTO_CD INTERACTIVE_COMMENTS

bindkey -e
bindkey '^[[A' history-search-backward
bindkey '^[[B' history-search-forward
bindkey '^[[3~' delete-char

# Cached completions
autoload -Uz compinit
_zcomp="${AY_SHELL_CACHE:-$HOME/.cache/shell}/zcompdump"
mkdir -p "${_zcomp:h}" 2>/dev/null
if [[ -s "$_zcomp" && ! "$_zcomp" -ot "${HOME}/.zshrc" ]]; then
  compinit -C -d "$_zcomp"
else
  compinit -d "$_zcomp"
fi
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'

# Aliases
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --icons=auto --group-directories-first'
  alias ll='eza -la --icons=auto --git --group-directories-first'
  alias la='eza -a --icons=auto --group-directories-first'
  alias lt='eza -T --level=2 --icons=auto --group-directories-first'
fi
command -v bat >/dev/null 2>&1 && alias cat='bat --paging=never'
alias g='git'
alias gs='git status -sb'
alias gd='git diff'
alias c='clear'
alias ff='fastfetch'

# Cached initializations
_ay_cache_eval() {
  local name="$1"; shift
  local f="${AY_SHELL_CACHE:-$HOME/.cache/shell}/zsh-${name}.zsh"
  if [[ ! -s "$f" ]]; then
    "$@" > "$f" 2>/dev/null || { rm -f "$f"; return 1; }
  fi
  source "$f"
}

command -v zoxide >/dev/null 2>&1 && _ay_cache_eval zoxide zoxide init zsh --cmd cd
command -v carapace >/dev/null 2>&1 && _ay_cache_eval carapace carapace _carapace zsh
command -v starship >/dev/null 2>&1 && _ay_cache_eval starship starship init zsh
command -v atuin >/dev/null 2>&1 && _ay_cache_eval atuin atuin init zsh --disable-up-arrow
if command -v fzf >/dev/null 2>&1; then
  export FZF_DEFAULT_OPTS="--color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8,fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc,marker:#b4befe,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8"
  _ay_cache_eval fzf fzf --zsh
fi

# System plugins when installed on Linux/macOS
for _p in \
  /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh \
  /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
  /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
  /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh; do
  [[ -r "$_p" ]] && source "$_p"
done
unset _p _zcomp
