# packages/machine/shells/bash/niubashrc — niubash 1.5 in interactive mode only reads ~/.niubashrc (niubash README, "On Windows,
# configuration is ONE file"): the shared bashrc is re-plugged here.
# niubash-root-fallback: "/" = NIU_ROOT; /<path> missing from NIU_ROOT -> system drive (cd /src -> C:\src),
# natif (aphrody-labs/niubash nt/fix-root-fallback).
export NIU_ROOT_FALLBACK=1
. "${BASH_SOURCE[0]%[/\\]*}/bashrc"
